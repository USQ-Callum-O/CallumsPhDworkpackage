#!/bin/bash -l
#PBS -N sim-8-01-11.0.2-09-resume
#PBS -l select=1:ncpus=40:mem=128gb
#PBS -l walltime=84:00:00
#PBS -l software=ansys
#PBS -j oe
#PBS -q default
#PBS -M u1173289@usq.edu.au
#PBS -P Callum_Ogilvies.PhD

set -Eeuo pipefail
cd "${PBS_O_WORKDIR:?Submit from the package root containing src and .venv}"
module purge
module load python/3.11.6-gcc-mzj
module load ansys/2025r1
source .venv/bin/activate
# Ensure the updated local source is used, even with a non-editable installation.
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
export CALLUMS_RESULTS_ROOT="${CALLUMS_RESULTS_ROOT:-$HOME/Simulations/Results}"
export I_MPI_FABRICS=shm
export MPLBACKEND=Agg
export PYTHONUNBUFFERED=1

CONFIG="configs/sim-8-01-11.0.2-09.fawkes.json"
# Prevent simultaneous resume jobs from writing the same run.
LOCK_DIR="$CALLUMS_RESULTS_ROOT/Hose_simulations/sim-8-01-11.0.2-09"
test -d "$LOCK_DIR"
exec 9>"$LOCK_DIR/.resume.lock"
flock -n 9 || { echo "Another resume job holds the lock for sim-8-01-11.0.2-09" >&2; exit 1; }
ARGS=("$CONFIG" --processors 36 --autosave-frequency "${AUTOSAVE_FREQUENCY:-15}")
if [[ -n "${CHECKPOINT_STEP:-}" ]]; then
    ARGS+=(--checkpoint-step "$CHECKPOINT_STEP")
fi
printf 'Resume job %s started at %s\n' "${PBS_JOBID:-local}" "$(date)"
python -m callums_simulation_package resume "${ARGS[@]}" --dry-run
python -m callums_simulation_package resume "${ARGS[@]}" --stages solve export plot
printf 'Resume job finished at %s\n' "$(date)"
