#!/bin/bash -l

#PBS -N sim-4-04-test
#PBS -l select=1:ncpus=4:mem=128gb
#PBS -l walltime=36:00:00
#PBS -l software=ansys
#PBS -j oe
#PBS -q default
#PBS -M u1173289@usq.edu.au
#PBS -P Callum_Ogilvies.PhD

set -euo pipefail

echo "============================================================"
echo "Job started: $(date)"
echo "PBS job ID: ${PBS_JOBID:-not-set}"
echo "Host: $(hostname)"
echo "Submission directory: ${PBS_O_WORKDIR:-not-set}"
echo "Node file: ${PBS_NODEFILE:-not-set}"
echo "============================================================"

cd "$PBS_O_WORKDIR"

module purge
module load python/3.11.6-gcc-mzj
module load ansys/2025r1

echo
echo "Loaded modules:"
module list

echo
echo "Python before virtual-environment activation:"
which python
python --version

echo
echo "Fluent executable:"
which fluent

source .venv/bin/activate

echo
echo "Python after virtual-environment activation:"
which python
python --version

echo
echo "callums-sim executable:"
which callums-sim

export CALLUMS_RESULTS_ROOT="$HOME/Simulations/Results"

# This was required for successful single-node Fluent startup.
export I_MPI_FABRICS=shm

# Plotting must use a non-interactive backend on the compute node.
export MPLBACKEND=Agg

CONFIG="${CONFIG:-configs/sim-4-04.fawkes.json}"
STAGES="${STAGES:-solve+export+plot}"

IFS='+' read -r -a STAGE_ARRAY <<< "$STAGES"

echo
echo "Configuration: $CONFIG"
echo "Stages: ${STAGE_ARRAY[*]}"
echo "Results root: $CALLUMS_RESULTS_ROOT"
echo "Matplotlib backend: $MPLBACKEND"
echo "MPI fabric: $I_MPI_FABRICS"
echo

echo "Resolved execution plan:"
callums-sim plan "$CONFIG" --stages "${STAGE_ARRAY[@]}"

echo
echo "Validating inputs:"
callums-sim validate "$CONFIG" --stages "${STAGE_ARRAY[@]}"

echo
echo "Starting simulation:"
callums-sim run "$CONFIG" --stages "${STAGE_ARRAY[@]}"

echo
echo "Generated export files:"
find \
    "$CALLUMS_RESULTS_ROOT/Nozzle_simulations/sim-4-04-02-01/Data_export" \
    -type f \
    -printf '%p %s bytes\n' \
    | sort

echo
echo "Generated plot files:"
find \
    "$CALLUMS_RESULTS_ROOT/Nozzle_simulations/sim-4-04-02-02/Results_plotting" \
    -type f \
    -printf '%p %s bytes\n' \
    | sort

echo
echo "============================================================"
echo "Job completed successfully: $(date)"
echo "============================================================"