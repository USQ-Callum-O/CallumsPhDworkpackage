  "metadata": {
    "purpose": "Cross-platform split-stage regression case migrated from legacy sim-1-12.",
    "migrated_from_config": "configs/sim-1-12_config.json",
    "legacy_meshing_script": "PyFluent/Meshing/snakebite_6_nozzle_only-meshing-1-12.py",
    "legacy_solver_script": "PyFluent/Nozzle_sim-1_code/snakebite_6_nozzle_only-solver-1-01.py",
    "legacy_postprocessing_script": "PyFluent/Poastprocessing/snakebite_6_nozzle_only-results-1-1.py",
    "legacy_processor_count": 4,
    "scientific_review_required": true,
    "known_migration_differences": [
      "The legacy Share Topology task ran only when Fluent exposed it; the structured workflow does not force that optional task.",
      "The legacy wall roughness and wall thermal-material assignments were inside a broad try/except and could fail silently; default smooth stationary no-slip walls are encoded explicitly instead.",
      "The generic export stage does not yet write the legacy mass-flow/convergence report CSV or report-monitor images.",
      "The legacy report named NE_P_static_avg actually sampled dynamic-pressure, so it is not treated as a static-pressure validation value."
    ]
  },
