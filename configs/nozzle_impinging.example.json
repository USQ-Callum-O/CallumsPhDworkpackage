        "BOIGrowthRate": 1.2,
        "BOISelectorType": "Labels",
        "BOIFaceLabelList": [
          "pressure-inlet"
        ]
      },
      {
        "AddChild": "yes",
        "BOIControlName": "boi_impingement",
        "BOIExecution": "Body Of Influence",
        "BOISize": 0.4,
        "BOIGrowthRate": 1.15,
        "BOIFaceLabelList": [
          "boi-7-solid"
        ]
      },
      {
        "AddChild": "yes",
        "BOIControlName": "boi_target",
        "BOIExecution": "Body Of Influence",
        "BOISize": 0.5,
        "BOIGrowthRate": 1.15,
        "BOIFaceLabelList": [
          "boi-10-solid"
        ]
      }
    ],
    "surface_mesh": {
      "MinimumSize": 0.1,
      "MaximumSize": 16.8,
      "GrowthRate": 1.15,
      "SizeFunction": "Curvature and Proximity",
      "CurvatureNormalAngle": 18.0,
      "NumCellsAcrossGap": 1,
      "ScopeProximity": "Edges",
      "SeparateBoundaryZone": "No"
    },
    "create_regions": {
      "NumberOfFlowVolumes": 1,
      "MeshObject": "Basic_Snakebite_#7_300mm_offset"
    },
    "volume_mesh": {
      "Solver": "Fluent",
      "VolumeFill": "poly-hexcore",
      "BufferLayers": 5,
      "PeelLayers": 3,
      "VolumeFillControls": {
        "HexMinCellLength": 0.7,
        "HexMaxCellLength": 33.6
      },
      "EnableParallelMeshing": true,
      "QualityMethod": "Orthogonal",
      "QualityLimit": 0.05,
      "UseSizeField": false,
      "PolyFeatureAngle": 30
    }
  },
  "solver": {
    "input": "mesh",
    "write_case_data": true,
    "operations": [
      {
