        "action": "set",
        "path": "settings/setup/boundary_conditions/@outlet.3/momentum/gauge_pressure",
        "value": 95343.15
      },
      {
        "action": "set",
        "path": "settings/setup/boundary_conditions/@outlet.5/momentum/gauge_pressure",
        "value": 95343.15
      },
      {
        "action": "call",
        "path": "settings/solution/initialization/hybrid_initialize"
      },
      {
        "action": "call",
        "path": "settings/solution/run_calculation/iterate",
        "kwargs": {
          "iter_count": 500,
          "report": true
        }
      }
    ]
  },
  "export": {
    "surfaces": [
      {
        "name": "axial_line",
        "kind": "line",
        "p0": [
          0.0,
          0.0,
          0.0
        ],
        "p1": [
          0.0,
          0.5,
          0.0
        ],
        "destination": "line",
        "fields": [
          "y-coordinate",
          "pressure",
          "total-pressure",
          "velocity-magnitude"
        ]
      },
      {
        "name": "midplane",
        "kind": "plane",
        "method": "yz-plane",
        "x": 0.0,
        "destination": "contour",
        "fields": [
          "y-coordinate",
          "z-coordinate",
          "pressure",
          "velocity-magnitude"
        ]
      }
    ]
  },
  "plotting": {
    "line_plots": [
      {
        "source": "Line_data/axial_line.csv",
        "x": "y-coordinate",
        "y": [
          "pressure",
          "total-pressure"
        ],
        "x_label": "Axial position (m)",
        "y_label": "Pressure (Pa)",
        "title": "Impinging-jet axial pressure",
        "filename": "Axial_line_plot.png"
      }
    ],
    "contour_plots": [
      {
